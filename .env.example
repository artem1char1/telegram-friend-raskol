TELEGRAM_BOT_TOKEN=
# После запуска получи ID группы через /chatid и впиши его сюда.
TELEGRAM_CHAT_IDS=

LLM_PROVIDER=groq
GROQ_API_KEY=

# Для локального запуска укажи LLM_PROVIDER=ollama.
OLLAMA_URL=http://127.0.0.1:11434
# Переопределение модели, если требуется.
# LLM_MODEL=

# Вероятность вступить в разговор после серии реплик и паузы. 0 отключает.
RASKOL_AMBIENT_CHANCE=0.08

# Через сколько минут тишины бот может начать разговор. 0 отключает этот режим.
RASKOL_IDLE_MINUTES=180

# Время приветствия. off отключает утреннее сообщение.
RASKOL_MORNING_TIME=09:00
RASKOL_TIMEZONE=Europe/Moscow
